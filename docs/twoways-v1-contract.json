  "native_support": [
    {
      "format": "text-markdown",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_text"
      ],
      "preservation": "source encoding, BOM, newline policy and untouched lexical source remain authoritative"
    },
    {
      "format": "csv",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_csv_cells"
      ],
      "preservation": "dialect, lexical field spans, quoting and physical row terminators are preserved outside targets"
    },
    {
      "format": "json",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_json_scalar"
      ],
      "preservation": "strict JSON pointer ownership and lexical scalar spans patch target values without whole-document serialization"
    },
    {
      "format": "xml",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_xml_attribute",
        "replace_xml_text"
      ],
      "preservation": "namespace-aware lexical ownership, declaration and untouched source bytes remain authoritative"
    },
    {
      "format": "html",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_html_attribute",
        "replace_html_text"
      ],
      "preservation": "recovery-aware lexical ownership and independent recovery signatures gate mutation"
    },
    {
      "format": "ipynb",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_ipynb_cell_source"
      ],
      "preservation": "cell source representation and notebook cardinality are preserved through JSON lexical lowering"
    },
    {
      "format": "epub",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_epub_metadata_text",
        "replace_epub_xhtml_text"
      ],
      "preservation": "OCF inventory, package graph and untouched member bytes are preserved through XML lowering"
    },
    {
      "format": "zip",
      "read": true,
      "native_write": true,
      "direct_operations": [],
      "routed_inner_operations": true,
      "preservation": "supported inner typed operations may be routed through exact member chains; ZIP structure remains read-only"
    },
    {
      "format": "pdf",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_pdf_link_uri",
        "update_pdf_metadata",
        "update_pdf_text_field_value"
      ],
      "preservation": "append-only incremental updates preserve original bytes as a prefix and require strict native ownership proofs"
    },
    {
      "format": "png",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_png_text_metadata"
      ],
      "preservation": "existing uniquely owned text chunks only; unrequested chunks remain byte-identical"
    },
    {
      "format": "jpeg",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_jpeg_exif_text"
      ],
      "preservation": "existing fixed-allocation Exif IFD0 text owners only; bytes outside authorized slots remain exact"
    },
    {
      "format": "mp3",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_mp3_id3v1_text"
      ],
      "preservation": "existing terminal ID3v1 fixed slots only; MPEG/audio bytes and unrelated metadata remain exact"
    },
    {
      "format": "msg",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_msg_subject_text"
      ],
      "preservation": "existing top-level Unicode Subject stream with exact encoded length only; CFB/MAPI topology remains fixed"
    },
    {
      "format": "xls",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_sheet_cells"
      ],
      "preservation": "existing BIFF8 NUMBER Xnum slots only; CFB/BIFF record and allocation topology remain immutable"
    },
    {
      "format": "xlsx",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "update_sheet_cells"
      ],
      "preservation": "typed non-formula non-merged cells only; original OOXML package and untouched members remain authoritative"
    },
    {
      "format": "pptx",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "move_resize",
        "replace_text",
        "set_alt_text",
        "set_text_style",
        "update_table_cells"
      ],
      "preservation": "bounded native slide text/style/geometry/alt-text/table mutation with ambiguous structures failing closed"
    },
    {
      "format": "docx",
      "read": true,
      "native_write": true,
      "direct_operations": [
        "replace_text",
        "set_alt_text",
        "set_text_style",
        "update_table_cells"
      ],
      "preservation": "bounded native document text/style/alt-text/table mutation with ambiguous structures failing closed"
    }
